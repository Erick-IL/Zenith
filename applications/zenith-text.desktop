[Desktop Entry]
Type=Application
Version=1.0
Name=Zenith — Editor
Comment=nano in foot, with the configuration shipped by the shell
Exec=footclient nano %f
Icon=@HOME@/.config/zenith/assets/logo-128.png
Terminal=false
Categories=Utility;
MimeType=text/plain;text/markdown;text/x-log;application/x-shellscript;text/x-python;text/x-lua;application/json;text/csv;
